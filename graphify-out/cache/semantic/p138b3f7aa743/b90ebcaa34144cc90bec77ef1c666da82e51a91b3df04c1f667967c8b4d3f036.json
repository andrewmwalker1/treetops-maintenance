{"nodes": [{"id": "supabase_consolidation_plan", "label": "Supabase Consolidation Plan", "file_type": "document", "source_file": "SUPABASE-CONSOLIDATION-PLAN.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_consolidation_plan_nano_tier_slowdown", "label": "Nano/Free Compute Tier Slowdown", "file_type": "concept", "source_file": "SUPABASE-CONSOLIDATION-PLAN.md", "source_location": "L5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Trigger for the whole plan: slowdown was the smallest compute tier under load, fixable for $25/mo; prompted sharing one project and one bill across apps."}, {"id": "supabase_consolidation_plan_schema_per_app", "label": "Schema-per-App Pattern", "file_type": "concept", "source_file": "SUPABASE-CONSOLIDATION-PLAN.md", "source_location": "L56", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each app in its own Postgres schema, exposed via pgrst.db_schemas; already proven in production by ParkMan2 and sidesteps table-name collisions like push_subscriptions."}, {"id": "supabase_consolidation_plan_option_a", "label": "Option A - Join Shared Project in Own Schema", "file_type": "concept", "source_file": "SUPABASE-CONSOLIDATION-PLAN.md", "source_location": "L66", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_consolidation_plan_option_b", "label": "Option B - Genuinely Shared Data Model", "file_type": "concept", "source_file": "SUPABASE-CONSOLIDATION-PLAN.md", "source_location": "L95", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A data model redesign (one canonical pitches table) rather than a relocation; deferred as follow-up once Option A is stable."}, {"id": "supabase_consolidation_plan_push_subscriptions_collision", "label": "push_subscriptions Table Name Collision", "file_type": "concept", "source_file": "SUPABASE-CONSOLIDATION-PLAN.md", "source_location": "L52", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_consolidation_plan_auth_hook_project_wide", "label": "Auth Hooks Are Project-Wide", "file_type": "concept", "source_file": "SUPABASE-CONSOLIDATION-PLAN.md", "source_location": "L200", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_consolidation_plan_edge_function_prefixing", "label": "Edge Function Name Prefixing", "file_type": "concept", "source_file": "SUPABASE-CONSOLIDATION-PLAN.md", "source_location": "L206", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Function names share one namespace per project; send-notice-push collided, so the moving app's functions get an app prefix (parkman2-*, hub-*) to avoid future accidental collisions."}, {"id": "supabase_consolidation_plan_secret_prefixing", "label": "Edge Function Secret Prefixing (VAPID)", "file_type": "concept", "source_file": "SUPABASE-CONSOLIDATION-PLAN.md", "source_location": "L217", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Secrets are one flat namespace per project, so VAPID secrets for the moving app are prefixed (HUB_VAPID_*); RESEND_API_KEY shared unprefixed. VAPID pairs not consolidated because changing a pair breaks existing push subscriptions."}, {"id": "supabase_consolidation_plan_db_schema_client_option", "label": "createClient db.schema Option", "file_type": "concept", "source_file": "SUPABASE-CONSOLIDATION-PLAN.md", "source_location": "L211", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_consolidation_plan_accept_content_profile_headers", "label": "Accept-Profile / Content-Profile Headers", "file_type": "concept", "source_file": "SUPABASE-CONSOLIDATION-PLAN.md", "source_location": "L592", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Raw fetch() calls to PostgREST bypass supabase-js, so schema selection must be set per-request via headers (hub-send-notice-push and 5 calls in Hub App.jsx)."}, {"id": "supabase_consolidation_plan_schema_relocation_substitution", "label": "Schema Relocation via public. Text Substitution", "file_type": "concept", "source_file": "SUPABASE-CONSOLIDATION-PLAN.md", "source_location": "L234", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Safe for fully schema-qualified SQL; Hub's SQL relied on search_path, so it also needed search_path wrappers and schemaname string-literal fixes, otherwise idempotency checks become silently always-false."}, {"id": "supabase_consolidation_plan_auth_uid_reconciliation", "label": "Auth Identity / UID Reconciliation", "file_type": "concept", "source_file": "SUPABASE-CONSOLIDATION-PLAN.md", "source_location": "L261", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Match by email, reuse existing UID or admin.createUser with email_confirm; remap in one transaction with deferred constraints. In execution done as load-order (non-auth tables first) instead of load-then-remap."}, {"id": "supabase_consolidation_plan_storage_byte_copy", "label": "Storage Byte Copy via REST API", "file_type": "concept", "source_file": "SUPABASE-CONSOLIDATION-PLAN.md", "source_location": "L275", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "storage schema is project-scoped so bytes are not in a schema dump; upsert:true makes re-runs safe; bucket names kept to avoid editing call sites."}, {"id": "supabase_consolidation_plan_execution_runbook", "label": "Execution Runbook Phases 0-5", "file_type": "concept", "source_file": "SUPABASE-CONSOLIDATION-PLAN.md", "source_location": "L294", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_consolidation_plan_freeze_cutover", "label": "Freeze Window and Cutover", "file_type": "concept", "source_file": "SUPABASE-CONSOLIDATION-PLAN.md", "source_location": "L286", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No in-app maintenance mode, so a short staff-communicated freeze; irreversible-feeling work done while old project still live, then full re-run not a diff."}, {"id": "supabase_consolidation_plan_one_week_rollback_window", "label": "One-Week Rollback Safety Window", "file_type": "rationale", "source_file": "SUPABASE-CONSOLIDATION-PLAN.md", "source_location": "L399", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deleting the old project is the only truly irreversible action; do not shorten under cost pressure."}, {"id": "supabase_consolidation_plan_direction_reversed", "label": "Direction Reversed - Hub and ParkMan2 Move Into Maintenance", "file_type": "concept", "source_file": "SUPABASE-CONSOLIDATION-PLAN.md", "source_location": "L430", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Andy: Maintenance is by far the most live app (RFID kiosk, constant use), so it should never go through a migration; Hub is simple and ParkMan2 a low-traffic prototype, so moving them is lower-stakes despite more work."}, {"id": "supabase_consolidation_plan_project_ozhwgrzlpvfdemmogmav", "label": "Shared Supabase Project ozhwgrzlpvfdemmogmav", "file_type": "concept", "source_file": "SUPABASE-CONSOLIDATION-PLAN.md", "source_location": "L417", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_consolidation_plan_project_qkbpsqlrzygcairtidye", "label": "Old Hub Project qkbpsqlrzygcairtidye (deleted)", "file_type": "concept", "source_file": "SUPABASE-CONSOLIDATION-PLAN.md", "source_location": "L419", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_consolidation_plan_hub_schema", "label": "hub Schema", "file_type": "concept", "source_file": "SUPABASE-CONSOLIDATION-PLAN.md", "source_location": "L534", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_consolidation_plan_parkman2_schema", "label": "parkman2 Schema", "file_type": "concept", "source_file": "SUPABASE-CONSOLIDATION-PLAN.md", "source_location": "L503", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Already fully parkman2.-qualified from day one, so replayed verbatim with zero substitution."}, {"id": "supabase_consolidation_plan_tree_tops_hub", "label": "Tree Tops Hub", "file_type": "concept", "source_file": "SUPABASE-CONSOLIDATION-PLAN.md", "source_location": "L8", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_consolidation_plan_parkman2", "label": "ParkMan2", "file_type": "concept", "source_file": "SUPABASE-CONSOLIDATION-PLAN.md", "source_location": "L8", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_consolidation_plan_maintenance_app", "label": "Maintenance App", "file_type": "concept", "source_file": "SUPABASE-CONSOLIDATION-PLAN.md", "source_location": "L8", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_consolidation_plan_undocumented_hub_tables", "label": "Undocumented Hub Tables (usage_events, push_subscriptions)", "file_type": "concept", "source_file": "SUPABASE-CONSOLIDATION-PLAN.md", "source_location": "L656", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_consolidation_plan_identity_sequence_advance", "label": "Identity Sequence Advance After OVERRIDING SYSTEM VALUE", "file_type": "concept", "source_file": "SUPABASE-CONSOLIDATION-PLAN.md", "source_location": "L778", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bulk-loading with OVERRIDING SYSTEM VALUE never advances the identity sequence, causing 23505 duplicate key; find all via information_schema.columns.is_identity and restart each sequence."}, {"id": "supabase_consolidation_plan_vapid_key_regeneration", "label": "Hub VAPID Key Regeneration", "file_type": "concept", "source_file": "SUPABASE-CONSOLIDATION-PLAN.md", "source_location": "L681", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Original values unrecoverable (dashboard shows only masked hashes); accepted trade-off of breaking 32 devices' push until resubscribed."}, {"id": "supabase_consolidation_plan_subscription_matches_current_key", "label": "subscriptionMatchesCurrentKey()", "file_type": "concept", "source_file": "SUPABASE-CONSOLIDATION-PLAN.md", "source_location": "L826", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Silently replaces stale subscriptions signed with the old public key, instead of relying on guests manually toggling notifications."}, {"id": "supabase_consolidation_plan_setup_admin_pin_skipped", "label": "setup-admin-pin.sql Skipped (dead code)", "file_type": "concept", "source_file": "SUPABASE-CONSOLIDATION-PLAN.md", "source_location": "L575", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_consolidation_plan_cloud_egress_block", "label": "Cloud Session Egress Block to Supabase", "file_type": "concept", "source_file": "SUPABASE-CONSOLIDATION-PLAN.md", "source_location": "L856", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_consolidation_plan_azure_sql_migration_plan", "label": "AZURE-SQL-MIGRATION-PLAN.md", "file_type": "document", "source_file": "SUPABASE-CONSOLIDATION-PLAN.md", "source_location": "L11", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_46_terminal_session_scoped_login_context", "label": "supabase/46-termin