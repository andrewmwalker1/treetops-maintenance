{"nodes": [{"id": "ui_redesign_plan", "label": "UI Redesign Plan", "file_type": "document", "source_file": "UI-REDESIGN-PLAN.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ui_redesign_plan_no_stylesheet_finding", "label": "No Stylesheet Finding (1,425 inline styles)", "file_type": "concept", "source_file": "UI-REDESIGN-PLAN.md", "source_location": "L23", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Inline styles cannot express :hover/:focus, so the app had zero interaction states and no focus ring; fixing it requires a real stylesheet, reversing the deliberate no-CSS choice in useIsMobile.js."}, {"id": "ui_redesign_plan_palette_drift", "label": "Palette Drift (Field Journal vs Admiralty)", "file_type": "concept", "source_file": "UI-REDESIGN-PLAN.md", "source_location": "L50", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "theme.js moved to navy Admiralty palette but PWA manifest, index.html theme-color, modal overlays and warning panels kept the old warm colours, so the installed PWA splash/status bar mismatched the app."}, {"id": "ui_redesign_plan_admiralty_palette", "label": "Admiralty Navy Palette", "file_type": "concept", "source_file": "UI-REDESIGN-PLAN.md", "source_location": "L173", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "D1: kept because it is what shipped and reads more professional; BUILD-BRIEF \u00a78 updated to match instead of reverting code."}, {"id": "ui_redesign_plan_five_navigation_idioms", "label": "Five Navigation Idioms Problem", "file_type": "concept", "source_file": "UI-REDESIGN-PLAN.md", "source_location": "L98", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ui_redesign_plan_touch_target_sizing", "label": "Touch Target Sizing (44px minimum)", "file_type": "concept", "source_file": "UI-REDESIGN-PLAN.md", "source_location": "L141", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Users tap in workshops/outdoors, often gloved; useIsMobile is a size check, not a pointer check, so wall-mounted touchscreens got 30px targets. Fixed via --control-h under @media (pointer: coarse)."}, {"id": "ui_redesign_plan_decisions_d1_d6", "label": "Decisions D1-D6", "file_type": "concept", "source_file": "UI-REDESIGN-PLAN.md", "source_location": "L166", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ui_redesign_plan_redesign_constraints", "label": "Redesign Constraints (must not break)", "file_type": "concept", "source_file": "UI-REDESIGN-PLAN.md", "source_location": "L182", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ui_redesign_plan_print_literal_colours", "label": "Print Output Keeps Literal Colours", "file_type": "rationale", "source_file": "UI-REDESIGN-PLAN.md", "source_location": "L186", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "printJobCards renders into a separate window via renderToStaticMarkup; CSS custom properties on the app document never reach it, so print components keep resolved hex values (rawColors)."}, {"id": "ui_redesign_plan_priority_colour_bar_rule", "label": "Priority Is a Solid Colour Bar, Never an Icon", "file_type": "rationale", "source_file": "UI-REDESIGN-PLAN.md", "source_location": "L196", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ui_redesign_plan_phase_1_foundation", "label": "Phase 1 - CSS Foundation and Token Layer", "file_type": "concept", "source_file": "UI-REDESIGN-PLAN.md", "source_location": "L217", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ui_redesign_plan_design_tokens", "label": "Design Tokens (type, spacing, radius, elevation, motion, control-h)", "file_type": "concept", "source_file": "UI-REDESIGN-PLAN.md", "source_location": "L224", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "7-step type scale and 4px spacing scale chosen to absorb existing ad-hoc values with minimal visual movement."}, {"id": "ui_redesign_plan_focus_visible_ring", "label": "Global :focus-visible Ring", "file_type": "concept", "source_file": "UI-REDESIGN-PLAN.md", "source_location": "L247", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Described as the single highest-value line in the plan; fixes both the not-sharp feel and an accessibility gap."}, {"id": "ui_redesign_plan_theme_js_hinge", "label": "theme.js Rewritten to Read Tokens (hinge)", "file_type": "concept", "source_file": "UI-REDESIGN-PLAN.md", "source_location": "L254", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same export names and shapes but values become var(--...), so all existing inline styles keep working and later phases can be incremental rather than a big-bang rewrite."}, {"id": "ui_redesign_plan_phase_2_ui_primitives", "label": "Phase 2 - UI Primitives", "file_type": "concept", "source_file": "UI-REDESIGN-PLAN.md", "source_location": "L277", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One place per control with real interaction states; thin React wrappers, no new dependency or CSS-in-JS."}, {"id": "ui_redesign_plan_phase_3_navigation_rebuild", "label": "Phase 3 - Navigation and Chrome Rebuild", "file_type": "concept", "source_file": "UI-REDESIGN-PLAN.md", "source_location": "L314", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ui_redesign_plan_admin_tabs_as_routes", "label": "Admin Tabs as Real Routes (/admin/:tab)", "file_type": "concept", "source_file": "UI-REDESIGN-PLAN.md", "source_location": "L360", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "activeTab was useState, so 20 admin screens could not be linked, bookmarked or refreshed and Back exited Admin; the biggest single usability problem."}, {"id": "ui_redesign_plan_mobile_bottom_tab_bar", "label": "Mobile Bottom Tab Bar", "file_type": "concept", "source_file": "UI-REDESIGN-PLAN.md", "source_location": "L355", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "D5: thumb-reachable, standard for a PWA, empties the cramped header; replaces NavMenu dropdown."}, {"id": "ui_redesign_plan_actiongrid_actionlist", "label": "ActionGrid / ActionList (unified hub pages)", "file_type": "concept", "source_file": "UI-REDESIGN-PLAN.md", "source_location": "L369", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "kioskTheme.js stops being a parallel style system and becomes a size=kiosk variant, removing font-size mismatches between KeysHome and KeyStationMenu."}, {"id": "ui_redesign_plan_phase_4_screen_pass", "label": "Phase 4 - Screen-by-Screen Pass", "file_type": "concept", "source_file": "UI-REDESIGN-PLAN.md", "source_location": "L385", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ui_redesign_plan_permission_matrix_card_view", "label": "Permission Matrix Sticky Column / Card View", "file_type": "concept", "source_file": "UI-REDESIGN-PLAN.md", "source_location": "L553", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Under 900px width query (not the phone check) the grid becomes one card per role, so half-width desktop windows also benefit."}, {"id": "ui_redesign_plan_phase_5_polish", "label": "Phase 5 - Polish", "file_type": "concept", "source_file": "UI-REDESIGN-PLAN.md", "source_location": "L419", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ui_redesign_plan_overdue_pill", "label": "Overdue Pill", "file_type": "concept", "source_file": "UI-REDESIGN-PLAN.md", "source_location": "L630", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "JobCard's 3px top border was easy to miss; replaced with a danger Pill while leaving the priority bar untouched."}, {"id": "ui_redesign_plan_phase_6_guardrails", "label": "Phase 6 - Guardrails", "file_type": "concept", "source_file": "UI-REDESIGN-PLAN.md", "source_location": "L441", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prevent drift recurring: UI rules in CLAUDE.md, an automated style check, and BUILD-BRIEF \u00a78 as single source of visual truth (duplication is how the token layer drifted before)."}, {"id": "ui_redesign_plan_check_styles_diff_only", "label": "check-styles Changed-Files-Only Diffing", "file_type": "rationale", "source_file": "UI-REDESIGN-PLAN.md", "source_location": "L688", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Diffs only files changed in the push (CHECK_STYLES_BASE = github.event.before) to catch new drift without failing on pre-existing code; needed fetch-depth: 0. Started non-blocking, flipped to blocking after clean pushes (8f); rgba added, literal px deferred because 199 hits would be landmines (8g)."}, {"id": "ui_redesign_plan_empty_state_sweep", "label": "Empty-State Sweep", "file_type": "concept", "source_file": "UI-REDESIGN-PLAN.md", "source_location": "L730", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each of ~42 sites judged individually; EmptyState's dashed box suits whole-section emptiness, so minor inline notes stayed plain text to avoid box-within-box. Actions added only where useful and never where they would abandon an in-progress form or dead-end unprivileged users."}, {"id": "ui_redesign_plan_viewascontrol_fix", "label": "ViewAsControl Dedicated-Class Fix", "file_type": "concept", "source_file": "UI-REDESIGN-PLAN.md", "source_location": "L811", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An inline style override on Button would permanently beat the CSS :hover rule, so a dedicated class pair in Layout.css was used instead."}, {"id": "ui_redesign_plan_px_tokenizing_sweep", "label": "Px Tokenizing Sweep", "file_type": "concept", "source_file": "UI-REDESIGN-PLAN.md", "source_location": "L907", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only tokenize a literal when a second identical use exists; values retained exactly (no rounding) since the app was only partially visually tested. Borders and one-offs deliberately left literal."}, {"id": "ui_redesign_plan_container_width_scale", "label": "Container Width Scale (--width-sm..2xl)", "file_type": "concept", "source_file": "UI-REDESIGN-PLAN.md", "source_location": "L923", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ui_redesign_plan_checkbox_size_tiers", "label": "Checkbox Size Tiers (--checkbox-size-sm/md/kiosk)", "file_type": "concept", "source_file": "UI-REDESIGN-PLAN.md", "source_location": "L977", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ui_redesign_plan_scrollbox_max_h", "label": "--scrollbox-max-h Token", "file_type": "concept", "source_file": "UI-REDESIGN-PLAN.md", "source_location": "L1032", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ui_redesign_plan_ui_gallery_route", "label": "/ui-gallery Dev Route", "file_type": "concept", "source_file": "UI-REDESIGN-PLAN.md", "source_location": "L504", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "build_brief", "label": "BUILD-BRIEF.md", "file_type": "document", "source_file": "UI-REDESIGN-PLAN.md", "source_location": "L8", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_styles_tokens", "label": 